<div class="page-width section">
  <div class="section-head"><div><p class="eyebrow">Order {{ order.name }}</p><h1 class="section-head__title">Order details</h1></div>
    <a href="{{ routes.account_url }}" class="section-head__link">Back to account</a></div>
  <p style="color:var(--color-muted);">Placed {{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>

  <table style="width:100%;border-collapse:collapse;margin-top:24px;font-size:0.92rem;">
    <thead><tr style="text-align:left;border-bottom:1px solid var(--color-border);"><th style="padding:10px;">Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr style="border-bottom:1px solid var(--color-border);">
          <td style="padding:10px;">{{ line.title }}</td>
          <td>{{ line.price | money }}</td>
          <td>{{ line.quantity }}</td>
          <td>{{ line.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="3" style="text-align:right;padding:10px;">Subtotal</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
      <tr><td colspan="3" style="text-align:right;padding:10px;">Shipping</td><td>{{ order.shipping_price | money }}</td></tr>
      <tr><td colspan="3" style="text-align:right;padding:10px;font-weight:800;">Total</td><td style="font-weight:800;">{{ order.total_price | money }}</td></tr>
    </tfoot>
  </table>
</div>
