<div class="page-width page-width--narrow section" style="max-width:460px;">
  <div class="section-head section-head--center"><h1 class="section-head__title">Reset your password</h1></div>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" class="field" placeholder="New password" required style="margin-bottom:12px;">
    <input type="password" name="customer[password_confirmation]" class="field" placeholder="Confirm password" required>
    <button type="submit" class="btn btn--gold btn--block btn--lg" style="margin-top:14px;">Reset password</button>
  {%- endform -%}
</div>
