<div style="margin-top:28px;">
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;gap:10px;max-width:380px;margin:0 auto;">
      <input type="password" name="password" class="field" placeholder="Enter store password" style="background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.2);color:#fff;" required>
      <button type="submit" class="btn btn--gold">Enter</button>
    </div>
  {%- endform -%}

  <div style="margin-top:32px;">
    <p class="eyebrow" style="justify-content:center;color:rgba(255,255,255,0.5);">Be first to know</p>
    {%- form 'customer', class: 'newsletter-form', style: 'max-width:380px;margin:10px auto 0;' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,password">
      <input type="email" name="contact[email]" class="field" placeholder="Email for early access" style="background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.2);color:#fff;" required>
      <button type="submit" class="btn btn--light">Notify me</button>
      {%- if form.posted_successfully? -%}<p style="color:var(--color-gold);width:100%;margin-top:8px;">You're on the list!</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>
