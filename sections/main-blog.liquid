<div class="page-width section" data-section-type="blog">
  <div class="section-head section-head--center">
    <p class="eyebrow">The Journal</p>
    <h1 class="section-head__title">{{ blog.title }}</h1>
  </div>
  <div class="grid" style="grid-template-columns:repeat(3,1fr);">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="reveal" style="display:block;">
        <div class="media" style="border-radius:var(--radius);aspect-ratio:16/10;">
          {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        <p class="product-card__vendor" style="margin-top:14px;">{{ article.published_at | date: '%b %d, %Y' }}</p>
        <h3 style="font-size:1.2rem;margin:4px 0;">{{ article.title }}</h3>
        <p style="color:var(--color-muted);">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Blog posts", "tag": "section", "settings": [] }
{% endschema %}
