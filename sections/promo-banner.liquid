<section class="section" data-section-type="promo">
  <div class="page-width">
    <div class="promo reveal">
      <div class="promo__bg">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750,1100,1500,2000', alt: '' }}
        {%- else -%}
          <div style="position:absolute;inset:0;background:linear-gradient(120deg,#111,#0a0a0a);"></div>
        {%- endif -%}
      </div>
      <div class="promo__inner">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:var(--color-gold);">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>

        {%- if section.settings.show_countdown -%}
          <div class="countdown" data-countdown data-deadline="{{ section.settings.deadline }}" data-duration-hours="{{ section.settings.duration_hours }}">
            <div class="countdown__unit"><div class="countdown__num" data-cd-days>00</div><div class="countdown__label">Days</div></div>
            <div class="countdown__unit"><div class="countdown__num" data-cd-hours>00</div><div class="countdown__label">Hrs</div></div>
            <div class="countdown__unit"><div class="countdown__num" data-cd-mins>00</div><div class="countdown__label">Min</div></div>
            <div class="countdown__unit"><div class="countdown__num" data-cd-secs>00</div><div class="countdown__label">Sec</div></div>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--gold btn--lg">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Final Whistle Sale" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Up to 44% off iconic kits. When the clock hits zero, the deal is gone." },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    { "type": "text", "id": "deadline", "label": "Deadline (YYYY-MM-DD HH:MM)", "info": "Leave blank to use a rolling timer.", "default": "" },
    { "type": "range", "id": "duration_hours", "min": 1, "max": 72, "step": 1, "unit": "h", "label": "Rolling timer length", "default": 24 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop the Sale" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}
