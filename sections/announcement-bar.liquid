{%- if section.blocks.size > 0 -%}
  <div class="announcement" data-announcement>
    <div class="page-width">
      <div class="announcement__track">
        {%- if section.blocks.size > 1 -%}
          <button class="announcement__nav" data-ann-prev aria-label="Previous announcement">{% render 'icon', name: 'chevron-left' %}</button>
        {%- endif -%}
        <div class="announcement__slides" style="height: var(--announcement-height);">
          {%- for block in section.blocks -%}
            <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" data-ann-slide {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > 1 -%}
          <button class="announcement__nav" data-ann-next aria-label="Next announcement">{% render 'icon', name: 'chevron-right' %}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Auto-rotate speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free worldwide shipping on orders over $120"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "message", "settings": { "text": "✦ Free worldwide shipping over $120" } },
      { "type": "message", "settings": { "text": "✦ 30-day easy returns — buy with confidence" } },
      { "type": "message", "settings": { "text": "✦ New season kits just dropped" } }
    ]
  },
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
