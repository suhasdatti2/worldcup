<div class="page-width section" data-section-type="search">
  <div class="section-head section-head--center">
    <p class="eyebrow">Search</p>
    <h1 class="section-head__title">
      {%- if search.performed -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}Search Novora{%- endif -%}
    </h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:560px;margin:0 auto 40px;position:relative;">
    <input type="search" name="q" value="{{ search.terms | escape }}" class="field" placeholder="{{ 'general.search.placeholder' | t }}" style="padding-left:46px;">
    <span style="position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--color-muted);">{% render 'icon', name: 'search' %}</span>
    <input type="hidden" name="type" value="product">
  </form>

  {%- if search.performed -%}
    {%- if search.results.size > 0 -%}
      <p class="collection-toolbar__count" style="margin-bottom:20px;">{{ search.results_count }} results</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item, index: forloop.index0 %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="text-align:center;color:var(--color-muted);padding:40px;">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search results", "tag": "section", "settings": [] }
{% endschema %}
