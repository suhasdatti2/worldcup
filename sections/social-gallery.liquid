<section class="section" data-section-type="social-gallery">
  <div class="page-width">
    <div class="section-head section-head--center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.handle != blank -%}<p style="color:var(--color-muted);">{{ section.settings.handle }}</p>{%- endif -%}
    </div>

    <div class="social-grid reveal">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}" class="social-grid__item" {{ block.shopify_attributes }} target="_blank" rel="noopener" aria-label="View on Instagram">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', sizes: '(max-width:749px) 33vw, 16vw', widths: '200,300,500', alt: '' }}
          {%- else -%}
            {%- assign ph = forloop.index0 | modulo: 6 | plus: 1 -%}
            {{ 'product-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="social-grid__icon">{% render 'icon', name: 'instagram' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#WearNovora" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Movement" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@novora" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "post" }, { "type": "post" }, { "type": "post" },
      { "type": "post" }, { "type": "post" }, { "type": "post" }
    ]
  },
  "presets": [{ "name": "Social gallery" }]
}
{% endschema %}
