{%- liquid
  assign source = product.collections.first
  assign related = source.products
-%}
{%- if related.size > 1 -%}
<section class="section" data-section-type="related">
  <div class="page-width">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="product-rail" data-product-rail>
      {%- assign shown = 0 -%}
      {%- for item in related -%}
        {%- if item.id != product.id and shown < section.settings.limit -%}
          {% render 'product-card', product: item, index: forloop.index0 %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the Kit" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Products", "default": 8 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
