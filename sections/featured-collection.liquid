{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
  assign products = collection.products
-%}

<section class="section{% if section.settings.dark %} bg-dark{% endif %}" data-section-type="featured-collection">
  <div class="page-width">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="section-head__link">View all{% if collection.products_count > limit %} ({{ collection.products_count }}){% endif %}</a>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="{% if section.settings.layout == 'slider' %}product-rail{% else %}product-grid{% endif %} reveal" data-product-rail>
        {%- for product in products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Onboarding placeholders {%- endcomment -%}
      <div class="product-grid reveal">
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__info">
              <p class="product-card__vendor">Novora</p>
              <h3 class="product-card__title"><a href="#">Example Jersey {{ i }}</a></h3>
              <div class="product-card__rating">{% render 'rating', value: 4.9, count: 124, show_count: true %}</div>
              <div class="product-card__price-row"><span class="product-card__price">$59.00</span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fan Favourites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "slider", "label": "Horizontal slider" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "slider"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' link", "default": true },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
