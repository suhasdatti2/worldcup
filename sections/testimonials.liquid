<section class="section{% if section.settings.dark %} bg-dark{% endif %}" data-section-type="testimonials">
  <div class="page-width">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
      <div class="rating">
        {% render 'rating', value: 5 %}
        <strong style="margin-left:6px;">{{ section.settings.aggregate }}</strong>
      </div>
    </div>

    <div class="testimonials__track" data-carousel>
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__rating">{% render 'rating', value: block.settings.rating %}</div>
          <blockquote class="testimonial__quote">“{{ block.settings.quote }}”</blockquote>
          <figcaption class="testimonial__author">
            {%- if block.settings.avatar != blank -%}
              {{ block.settings.avatar | image_url: width: 92 | image_tag: class: 'testimonial__avatar', loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              <span class="testimonial__avatar" aria-hidden="true"></span>
            {%- endif -%}
            <div>
              <div class="testimonial__name">{{ block.settings.name }}</div>
              <div class="testimonial__verified">{% render 'icon', name: 'check-circle' %} Verified buyer · {{ block.settings.location }}</div>
            </div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved Worldwide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Fans Are Saying" },
    { "type": "text", "id": "aggregate", "label": "Aggregate label", "default": "4.9 / 5 · 6,400+ reviews" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": true }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Customer photo" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Unreal quality. The fabric and fit feel exactly like a pro kit. Shipping was fast too." },
        { "type": "text", "id": "name", "label": "Name", "default": "Marcus T." },
        { "type": "text", "id": "location", "label": "Location", "default": "London, UK" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "review", "settings": { "name": "Marcus T.", "location": "London, UK", "quote": "Unreal quality. The fabric and fit feel exactly like a pro kit. Shipping was fast too." } },
      { "type": "review", "settings": { "name": "Sofia R.", "location": "Madrid, ES", "quote": "Bought three kits for the family. The colors are vivid and the stitching is perfect." } },
      { "type": "review", "settings": { "name": "Daniel K.", "location": "Berlin, DE", "quote": "Best jersey I’ve owned. Premium packaging, premium feel. Already ordered another." } },
      { "type": "review", "settings": { "name": "Aiko M.", "location": "Tokyo, JP", "quote": "Looks even better in person. Wore it to the match and got so many compliments." } }
    ]
  },
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
