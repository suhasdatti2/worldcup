<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="footer-top">

      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="footer-brand__logo">{{ settings.brand_name | default: shop.name }}</a>
        <p>{{ section.settings.about_text | default: settings.brand_tagline }}</p>

        <div class="footer-social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.social_x != blank -%}<a href="{{ settings.social_x }}" aria-label="X" rel="noopener" target="_blank">{% render 'icon', name: 'x-twitter' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube" rel="noopener" target="_blank">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer-col" {{ block.shopify_attributes }}>
              <p class="footer-col__title">{{ block.settings.heading }}</p>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>
          {%- when 'newsletter' -%}
            <div class="footer-col" {{ block.shopify_attributes }}>
              <p class="footer-col__title">{{ block.settings.heading }}</p>
              <p style="font-size:0.88rem;">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'newsletter-form', style: 'margin-top:14px;' -%}
                <input type="hidden" name="contact[tags]" value="newsletter,footer">
                <input type="email" name="contact[email]" class="field" placeholder="Email address" aria-label="Email" required>
                <button type="submit" class="btn btn--gold">{% render 'icon', name: 'arrow-right' %}</button>
                {%- if form.posted_successfully? -%}
                  <p style="color:var(--color-gold);font-size:0.85rem;margin-top:8px;">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}

    </div>

    <div class="footer-bottom">
      <div class="footer-selectors">
        {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
          {%- form 'localization' -%}
            <select name="locale_code" onchange="this.form.submit()" aria-label="Language">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_currency_selector and localization.available_countries.size > 1 -%}
          {%- form 'localization' -%}
            <select name="country_code" onchange="this.form.submit()" aria-label="Country / currency">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}
      </div>

      <div class="footer-payments">
        {% render 'icon', name: 'visa' %}
        {% render 'icon', name: 'mastercard' %}
        {% render 'icon', name: 'amex' %}
        {% render 'icon', name: 'paypal' %}
        {% render 'icon', name: 'applepay' %}
        {% render 'icon', name: 'shoppay' %}
      </div>

      <div class="footer-copyright">
        © {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. {{ section.settings.copyright_note }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "About text", "default": "Premium football jerseys inspired by the world’s biggest matches. Wear your passion. Represent your colors." },
    { "type": "checkbox", "id": "show_currency_selector", "label": "Show currency selector", "default": true },
    { "type": "checkbox", "id": "show_locale_selector", "label": "Show language selector", "default": true },
    { "type": "text", "id": "copyright_note", "label": "Copyright note", "default": "An independent football apparel brand. Not affiliated with FIFA or any national federation." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Squad" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get early access to drops and exclusive offers." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Support" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
