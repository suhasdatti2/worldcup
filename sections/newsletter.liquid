<section class="section" data-section-type="newsletter">
  <div class="page-width">
    <div class="newsletter-band reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:var(--color-blue);justify-content:center;">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter.label' | t }}</label>
        <input type="email" id="NewsletterEmail" name="contact[email]" class="field" placeholder="Enter your email" required>
        <button type="submit" class="btn btn--gold">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}
          <p style="color:var(--color-gold);margin-top:10px;width:100%;">{{ 'general.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p style="color:#ff8080;margin-top:10px;width:100%;">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="newsletter-band__note">{{ section.settings.note }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get 10% Off" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Squad" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe for early access to drops, exclusive offers, and 10% off your first order." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Claim 10% Off" },
    { "type": "text", "id": "note", "label": "Note", "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
