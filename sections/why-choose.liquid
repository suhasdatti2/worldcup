<section class="section{% if section.settings.dark %} bg-dark{% endif %}" data-section-type="why-choose">
  <div class="page-width">
    <div class="section-head section-head--center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
    </div>

    <div class="features-grid">
      {%- for block in section.blocks -%}
        <div class="feature reveal" style="--reveal-delay: {{ forloop.index0 | times: 0.06 }}s;" {{ block.shopify_attributes }}>
          <div class="feature__icon">{% render 'icon', name: block.settings.icon %}</div>
          <h3 class="feature__title">{{ block.settings.title }}</h3>
          <p class="feature__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why choose us",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Novora Standard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Novora" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "medal", "label": "Medal" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "shield", "label": "Shield" },
            { "value": "globe", "label": "Globe" },
            { "value": "bolt", "label": "Bolt" }
          ],
          "default": "medal"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Materials" },
        { "type": "text", "id": "text", "label": "Text", "default": "Match-grade, breathable fabric." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "feature", "settings": { "icon": "medal", "title": "Premium Materials", "text": "Match-grade, breathable fabric." } },
      { "type": "feature", "settings": { "icon": "truck", "title": "Worldwide Shipping", "text": "Fast delivery to 120+ countries." } },
      { "type": "feature", "settings": { "icon": "lock", "title": "Secure Checkout", "text": "256-bit SSL encryption." } },
      { "type": "feature", "settings": { "icon": "refresh", "title": "Easy Returns", "text": "30-day hassle-free returns." } },
      { "type": "feature", "settings": { "icon": "shield", "title": "Quality Guaranteed", "text": "Built to last every season." } }
    ]
  },
  "presets": [{ "name": "Why choose us" }]
}
{% endschema %}
