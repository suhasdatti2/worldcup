{%- liquid
  assign pool = product.collections.first.products
  assign extras = ''
  assign ids = ''
  assign total = product.price
  assign count = 1
-%}
{%- if pool.size > 1 -%}
<section class="section section--tight" data-section-type="fbt">
  <div class="page-width">
    <div class="bundle" style="margin:0;">
      <div class="bundle__title">{% render 'icon', name: 'check-circle' %} <strong>{{ section.settings.heading }}</strong></div>

      <div class="fbt" data-fbt>
        {%- comment -%} Current product {%- endcomment -%}
        <div class="fbt__item" data-fbt-item data-variant="{{ product.selected_or_first_available_variant.id }}" data-price="{{ product.price }}">
          <div class="media">
            {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 220 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}
          </div>
          <div class="fbt__price">This item</div>
          <div class="fbt__price">{{ product.price | money }}</div>
        </div>

        {%- assign added = 0 -%}
        {%- for item in pool -%}
          {%- if item.id != product.id and item.available and added < 2 -%}
            <span class="fbt__plus">+</span>
            <div class="fbt__item" data-fbt-item data-variant="{{ item.selected_or_first_available_variant.id }}" data-price="{{ item.price }}" data-checked="true">
              <a href="{{ item.url }}" class="media">
                {%- if item.featured_media -%}{{ item.featured_media | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
              </a>
              <label style="display:flex;align-items:center;gap:6px;justify-content:center;margin-top:6px;font-size:0.8rem;cursor:pointer;">
                <input type="checkbox" data-fbt-check checked> {{ item.title | truncate: 16 }}
              </label>
              <div class="fbt__price">{{ item.price | money }}</div>
            </div>
            {%- assign total = total | plus: item.price -%}
            {%- assign count = count | plus: 1 -%}
            {%- assign added = added | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="fbt__summary">
          <div style="font-size:0.85rem;color:var(--color-muted);">Total price (<span data-fbt-count>{{ count }}</span> items)</div>
          <div style="font-family:var(--font-heading);font-weight:800;font-size:1.5rem;" data-fbt-total>{{ total | money }}</div>
          <button type="button" class="btn btn--gold" data-fbt-add style="margin-top:8px;">Add all to cart</button>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Frequently bought together",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" }
  ],
  "presets": [{ "name": "Frequently bought together" }]
}
{% endschema %}
