<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
    {{ content_for_header }}
    {%- liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
    -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}
    <style>
      :root{
        --color-text:{{ settings.color_text }};--color-gold:{{ settings.color_gold }};--color-blue:{{ settings.color_blue }};
        --font-heading:{{ heading_font.family }},{{ heading_font.fallback_families }};
        --font-body:{{ body_font.family }},{{ body_font.fallback_families }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password" style="background:var(--color-dark);color:#fff;min-height:100vh;display:grid;place-items:center;text-align:center;padding:24px;">
    <main style="max-width:520px;">
      <p class="eyebrow" style="justify-content:center;color:var(--color-gold);">Coming soon</p>
      <h1 style="font-size:clamp(2.4rem,7vw,4.5rem);">{{ settings.brand_name | default: shop.name }}</h1>
      <p style="color:rgba(255,255,255,0.7);">{{ settings.brand_tagline }}</p>
      {{ content_for_layout }}
      <p style="margin-top:24px;opacity:0.5;font-size:0.85rem;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </main>
  </body>
</html>
