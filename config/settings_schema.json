[
  {
    "name": "theme_info",
    "theme_name": "Novora",
    "theme_version": "1.0.0",
    "theme_author": "Novora",
    "theme_documentation_url": "https://novora.com",
    "theme_support_url": "https://novora.com/support"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "NOVORA"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "Wear Your Passion. Represent Your Colors."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Optional. If empty, the brand name is used as the logo."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 5,
        "unit": "px",
        "label": "Logo width",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Core palette"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text / Matte black",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (clay)",
        "default": "#F4F1EA"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / cards",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark sections background",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Accent — Metallic gold",
        "default": "#D4AF37"
      },
      {
        "type": "color",
        "id": "color_blue",
        "label": "Highlight — Electric blue",
        "default": "#00C2FF"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#6B6B6B"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "archivo_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 14
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable scroll & hover animations",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show team / vendor name",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "Show star rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Show Quick Add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_wishlist",
        "label": "Show wishlist icon",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Slide-out drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "enable_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "$",
        "label": "Free shipping threshold",
        "default": 120
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Cart upsell collection",
        "info": "Products recommended in the cart drawer."
      }
    ]
  },
  {
    "name": "Social proof",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_recent_purchases",
        "label": "Show recent purchase notifications",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_newsletter_popup",
        "label": "Show first-order discount popup",
        "default": true
      },
      {
        "type": "text",
        "id": "newsletter_discount_code",
        "label": "Discount code shown in popup",
        "default": "WELCOME10"
      },
      {
        "type": "range",
        "id": "newsletter_popup_delay",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "s",
        "label": "Popup delay",
        "default": 6
      },
      {
        "type": "image_picker",
        "id": "newsletter_popup_image",
        "label": "Popup image"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_x", "label": "X / Twitter URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  }
]
